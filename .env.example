# NetPi Production Configuration
# Copy to /opt/netpi/.env or set via systemd Environment= directives

# Security
NETPI_API_KEY=change-me-in-production

# CORS \u2014 comma-separated list, or leave empty for default "*"
NETPI_CORS_ORIGINS=http://localhost:3000,http://192.168.1.100

# Paths
NETPI_DATA_DIR=/var/lib/netpi
NETPI_CAPTURE_DIR=/var/lib/netpi/captures

# Logging: DEBUG, INFO, WARNING, ERROR
NETPI_LOG_LEVEL=INFO

# Capture limits
NETPI_MAX_CAPTURE_SIZE_MB=1024



